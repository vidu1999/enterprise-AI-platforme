# ── Copy to .env (root) / apps/api/.env / apps/web/.env.local as needed ──
# Database (local docker-compose default)
DATABASE_URL=postgresql://opspilot:opspilot_dev_password@localhost:5432/opspilot?schema=public
# Supabase alternative (pooler): postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://opspilot:opspilot_dev_password@localhost:5432/opspilot?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-32-char-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
API_PORT=3001
WEB_PORT=3000
AI_SERVICE_URL=http://localhost:8001
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
NEXT_PUBLIC_API_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@opspilot.local
