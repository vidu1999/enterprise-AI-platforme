// OpsPilot — Prisma schema (PostgreSQL)
// Multi-tenancy: every tenant-owned row carries companyId. All queries are
// scoped by companyId (enforced in service layer + documented in docs/SECURITY.md).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  EMPLOYEE
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
}

enum NotificationType {
  TASK_ASSIGNED
  APPROVAL_REQUESTED
  APPROVED
  REJECTED
  LOW_STOCK
  WORK_ORDER_UPDATE
  SYSTEM
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  departments     Department[]
  suppliers       Supplier[]
  inventoryItems  InventoryItem[]
  assets          Asset[]
  workOrders      WorkOrder[]
  purchaseOrders  PurchaseOrder[]
  approvals       Approval[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  documents       Document[]
}

model User {
  id           String     @id @default(uuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         Role       @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens   RefreshToken[]
  assignedOrders  WorkOrder[]      @relation("Assignee")
  createdOrders   WorkOrder[]      @relation("Creator")
  notifications   Notification[]
  auditLogs       AuditLog[]       @relation("Actor")
  approvals       Approval[]       @relation("Approver")

  @@unique([companyId, email])
  @@index([companyId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model Department {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  users     User[]
  @@unique([companyId, name])
  @@index([companyId])
}

model Supplier {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  items     InventoryItem[]
  purchaseOrders PurchaseOrder[]
  @@unique([companyId, name])
  @@index([companyId])
}

model InventoryItem {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  category    String?
  unit        String   @default("pcs")
  quantity    Int      @default(0)
  reorderLevel Int     @default(10)
  unitCost    Decimal? @db.Decimal(12, 2)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions InventoryTransaction[]
  poLines      PurchaseOrderLine[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model InventoryTransaction {
  id        String          @id @default(uuid())
  companyId String
  itemId    String
  item      InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      TransactionType
  quantity  Int
  note      String?
  createdAt DateTime        @default(now())
  @@index([companyId, itemId])
}

model Asset {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  name        String
  category    String?
  location    String?
  status      String   @default("OPERATIONAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workOrders  WorkOrder[]
  @@unique([companyId, code])
  @@index([companyId])
}

model WorkOrder {
  id          String          @id @default(uuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      WorkOrderStatus @default(OPEN)
  priority    Priority        @default(MEDIUM)
  assetId     String?
  asset       Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?           @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId   String?
  creator     User?           @relation("Creator", fields: [creatorId], references: [id], onDelete: SetNull)
  estimatedCost Decimal?      @db.Decimal(12, 2)
  actualCost    Decimal?      @db.Decimal(12, 2)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([companyId, status])
}

model PurchaseOrder {
  id         String         @id @default(uuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number     String
  supplierId String
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  status     ApprovalStatus @default(PENDING)
  total      Decimal?       @db.Decimal(12, 2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lines      PurchaseOrderLine[]
  @@unique([companyId, number])
  @@index([companyId])
}

model PurchaseOrderLine {
  id            String        @id @default(uuid())
  orderId       String
  order         PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id])
  quantity      Int
  unitCost      Decimal       @db.Decimal(12, 2)
}

model Approval {
  id         String         @id @default(uuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type       String         // PURCHASE_ORDER | WORK_ORDER | CUSTOM
  refId      String
  title      String
  status     ApprovalStatus @default(PENDING)
  approverId String?
  approver   User?          @relation("Approver", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt  DateTime?
  comment    String?
  createdAt  DateTime       @default(now())
  @@index([companyId, status])
}

model Notification {
  id        String           @id @default(uuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  @@index([companyId, userId, read])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}

model Document {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  @@index([companyId])
}
